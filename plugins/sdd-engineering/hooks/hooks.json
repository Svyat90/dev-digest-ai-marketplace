{
  "description": "Scope and lint guards for the spec-creator and implementation-planner agents, each acting only inside its own agent, plus a guard that sends new specs through spec-creator.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/spec-writer-guard.mjs", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/spec-creator-scope.mjs", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/implementation-planner-scope.mjs", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/spec-creator-lint.mjs", "timeout": 30 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/implementation-planner-lint.mjs", "timeout": 30 }
        ]
      }
    ]
  }
}
