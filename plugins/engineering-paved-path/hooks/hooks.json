{
  "description": "Blocks git push --force to main or master before the command runs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-force-push.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
